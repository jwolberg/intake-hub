# Production hub image: build the Vite bundle, serve it static via nginx on 8080
# (Cloud Run's default container port). VITE_API_URL is baked in at build time —
# the bundle is static, so the deployed API URL must be known when this builds.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# Unprivileged nginx (#0014): runs as uid 101, listens on 8080.
FROM nginxinc/nginx-unprivileged:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# Fail the image build (and CI) on an invalid config.
RUN nginx -t
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
